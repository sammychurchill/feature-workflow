#!/usr/bin/env bash
# SessionStart hook for feature-workflow plugin
# Injects the workflow-guide skill into session context on startup.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read the workflow-guide skill content
guide_content=$(cat "${PLUGIN_ROOT}/skills/workflow-guide/SKILL.md" 2>&1 || echo "Error reading workflow-guide skill")

# Escape string for safe JSON embedding using bash parameter substitution.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

guide_escaped=$(escape_for_json "$guide_content")
session_context="<IMPORTANT>\nYou have the feature-workflow skill system installed.\n\n**Below is the full content of the workflow-guide skill -- your guide to using all available skills. For all other skills, use the Skill tool:**\n\n${guide_escaped}\n</IMPORTANT>"

# Platform-specific output format:
# - Cursor: additional_context
# - Claude Code: hookSpecificOutput.additionalContext
# Uses printf instead of heredoc to avoid bash 5.3+ expansion bugs
# with large content.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
fi

exit 0
